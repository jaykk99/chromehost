# ── ChromeHost ────────────────────────────────────────────────────────────────
# COMPOSIO_API_KEY: for Gmail, social posting, and other Composio tools.
# Get one at https://composio.dev. Optional — can also be pasted in the
# Settings UI at /#/chromehost (stored server-side in SQLite, never exposed).
# COMPOSIO_API_KEY="your_composio_key"

# CHROMEHOST_DATA_DIR: override the data directory (default: ./data, or /app/data in Docker)
# CHROMEHOST_DATA_DIR="/app/data"

# ── Monico Labs base (legacy) ─────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VORTEX_LIVE_API_KEY: Bearer key for the agent deploy webhook (POST /api/vortex/agent/deploy).
# Optional. When set, it also serves as the MCP bearer token (unless VRX_MCP_AUTH_TOKEN is set).
# When neither is set, the server generates a random token at startup and prints it to the console.
# Note: the MCP endpoints (/api/mcp, /api/monico-labs.mcp) REQUIRE a bearer token: VRX_MCP_AUTH_TOKEN, or this key as fallback.
# VORTEX_LIVE_API_KEY="set-a-long-random-secret-here"

# ── Local Termux Host ─────────────────────────────────────────────────────────
# Set to your device's LAN IP to reach the server from other devices on the same WiFi.
# Leave as 'localhost' to access only from the Termux device itself.
VORTEX_HOST="localhost"

# VORTEX_PORT: Port the server listens on (Android/Termux requires > 1024 without root).
# Cloud hosts (Render/Railway/Cloud Run) inject PORT automatically and take precedence.
VORTEX_PORT="3000"

# ── Supabase (optional — enables cloud SQL via the query_database MCP tool) ───
# If both are set, query_database delegates to Supabase via the execute_sql RPC function.
# Leave unset to use the built-in local vortex_local_db.json database.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
